// Brutus v3 — Prisma schema
// SQLite local; switch `provider` to "postgresql" + run `prisma migrate dev`
// when promoting to a hosted DB. JSON-shaped fields (skills/weapons/pets/
// appearance, combat log, tournament rounds) are stored as TEXT and
// (de)serialised in `server/src/lib/serialization.ts`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  walletAddress String?  @unique // placeholder web3
  createdAt     DateTime @default(now())
  brutes        Brute[]
}

model Brute {
  id                      String   @id @default(cuid())
  userId                  String?
  user                    User?    @relation(fields: [userId], references: [id])
  name                    String   @unique
  ownerWallet             String?
  onChainBruteId          Int?
  createTxHash            String?  @unique
  seed                    Int
  level                   Int      @default(1)
  xp                      Int      @default(0)
  rank                    Int      @default(0)
  hp                      Int
  strength                Int
  agility                 Int
  speed                   Int
  skills                  String   // JSON array
  weapons                 String   // JSON array
  pets                    String   // JSON array
  appearance              String   // JSON object (legacy: gender/skin/hair/shirt/pants)
  // Renderer Pixi (porteado de LaBrute):
  gender                  String   @default("male") // "male" | "female"
  body                    String   @default("") // 11 hex chars
  bodyColors              String   @default("") // 32 hex chars
  victories               Int      @default(0) // legacy aggregate displayed on old profiles
  defeats                 Int      @default(0) // legacy aggregate displayed on old profiles
  normalVictories         Int      @default(0) // official normal-fight wins for leaderboard/rewards
  normalDefeats           Int      @default(0) // official normal-fight losses for leaderboard
  fightsRemaining         Int      @default(3)
  trainingFightsRemaining Int      @default(10)
  defeatsToday            Int      @default(0)
  lastFightReset          DateTime @default(now())
  pendingLevelUpChoices   String?
  pendingLevelUpLevel     Int?
  pendingLevelUpNonce     String?
  masterId                String?
  master                  Brute?   @relation("Pupils", fields: [masterId], references: [id])
  pupils                  Brute[]  @relation("Pupils")
  combatsAsA              Combat[]      @relation("CombatA")
  combatsAsB              Combat[]      @relation("CombatB")
  matchTicketsAsPlayer    MatchTicket[] @relation("MatchTicketPlayer")
  matchTicketsAsOpponent  MatchTicket[] @relation("MatchTicketOpponent")
  createdAt               DateTime @default(now())

  @@index([userId])
  @@index([ownerWallet])
  @@index([onChainBruteId])
  @@index([masterId])
}

model Combat {
  id        String   @id @default(cuid())
  bruteAId  String
  bruteA    Brute    @relation("CombatA", fields: [bruteAId], references: [id])
  bruteBId  String
  bruteB    Brute    @relation("CombatB", fields: [bruteBId], references: [id])
  winner    String   // 'A' | 'B'
  log       String   // JSON
  fightType             String   @default("normal") // 'normal' | 'training' | 'tournament'
  rewardFightId         String?  @unique
  rewardWinnerWallet    String?
  rewardRecordedTxHash  String?
  rewardClaimTxHash     String?
  rewardClaimedAt       DateTime?
  createdAt             DateTime @default(now())

  @@index([bruteAId])
  @@index([bruteBId])
}

model Tournament {
  id        String   @id @default(cuid())
  playerId  String
  rounds    String   // JSON array of rounds
  champion  String   // bruteId
  ascended  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([playerId])
}

model MatchTicket {
  id         String    @id @default(cuid())
  playerId   String
  player     Brute     @relation("MatchTicketPlayer", fields: [playerId], references: [id], onDelete: Cascade)
  opponentId String
  opponent   Brute     @relation("MatchTicketOpponent", fields: [opponentId], references: [id], onDelete: Cascade)
  wallet     String
  fightType  String    @default("normal")
  usedAt     DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([playerId])
  @@index([opponentId])
  @@index([wallet])
  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  wallet    String?
  bruteId   String?
  action    String
  metadata  String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([wallet])
  @@index([bruteId])
  @@index([action])
  @@index([createdAt])
}
